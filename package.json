{
  "name": "@nforma.ai/nf-benchmark",
  "version": "0.1.0",
  "description": "Benchmark suite for measuring nf:solve autonomous fixing capability across 100 challenges",
  "type": "module",
  "bin": {
    "nf-benchmark": "./bin/nf-benchmark.cjs"
  },
  "scripts": {
    "test": "node --test test/*.test.cjs",
    "run": "node bin/nf-benchmark.cjs",
    "fixtures": "node bin/run-fixtures.cjs",
    "run:single": "node bin/nf-benchmark.cjs --single",
    "run:category": "node bin/nf-benchmark.cjs --category",
    "report": "node bin/nf-benchmark.cjs --report",
    "validate": "node bin/validate-challenges.cjs",
    "precision": "node bin/precision-harness.cjs --sut-bin \"${SUT_BIN:-$HOME/.claude/nf-bin}\"",
    "recall": "node bin/recall-harness.cjs --sut-bin \"${SUT_BIN:-$HOME/.claude/nf-bin}\"",
    "exactness": "node bin/exactness-report.cjs --sut-bin \"${SUT_BIN:-$HOME/.claude/nf-bin}\"",
    "coverage-audit": "node bin/coverage-audit.cjs",
    "capability-map": "node bin/capability-map.cjs",
    "bug-history": "node bin/bug-history-miner.cjs",
    "oracle-track": "node bin/oracle-track.cjs",
    "mutation-validity": "node bin/mutation-validity.cjs"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nForma-AI/nf-benchmark.git"
  }
}
