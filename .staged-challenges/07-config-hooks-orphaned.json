[
  {
    "id": "BENCH-071",
    "title": "Impossible quorum consensus value",
    "category": "config-hooks",
    "difficulty": "easy",
    "description": "Set quorum min_consensus to 0 or > number of agents",
    "target_layers": [
      "t_to_c"
    ],
    "mutation": {
      "type": "json-field-modify",
      "target_file": "templates/nf.json",
      "json_path": "$.quorum.min_consensus",
      "value": 0,
      "description": "Set min_consensus to impossible value"
    },
    "expected_outcome": {
      "residual_change": "increase",
      "description": "nf:solve should detect invalid config value",
      "layers_affected": [
        "t_to_c"
      ]
    },
    "scoring": {
      "method": "detection_only",
      "timeout_seconds": 300
    },
    "tags": [
      "config",
      "quorum"
    ]
  },
  {
    "id": "BENCH-072",
    "title": "Missing required config field",
